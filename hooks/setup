#!/bin/bash

# Refine Gate Setup — enable/disable the refine gate per project.
#
# Usage:
#   hooks/setup --json                  # print status
#   hooks/setup --json --enable-gate    # enable and print status
#   hooks/setup --json --disable-gate   # disable and print status

# Per-project state, derived from the workspace — works from hooks and from
# the /refine:setup command alike (no hook-only env like CLAUDE_PLUGIN_DATA needed).
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
# Key = readable basename + checksum of the full path (collision-resistant:
# sanitizing alone would map e.g. /a/b-c and /a/b/c to the same key)
PROJECT_KEY="$(printf '%s' "$(basename "$PROJECT_DIR")" | tr -c 'a-zA-Z0-9' '-')-$(printf '%s' "$PROJECT_DIR" | cksum | cut -d' ' -f1)"
DATA_DIR="$HOME/.claude/refine-gate/$PROJECT_KEY"
CONFIG_FILE="$DATA_DIR/config.json"

ensure_config() {
  mkdir -p "$DATA_DIR"
  if [ ! -f "$CONFIG_FILE" ]; then
    echo '{"refineGate": false}' > "$CONFIG_FILE"
  fi
}

read_gate() {
  jq -r '.refineGate // false' "$CONFIG_FILE" 2>/dev/null
}

set_gate() {
  local val="$1"
  local tmp="${CONFIG_FILE}.tmp"
  jq --argjson v "$val" '.refineGate = $v' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
}

# Parse args
JSON=false
ACTION=""
for arg in "$@"; do
  case "$arg" in
    --json)         JSON=true ;;
    --enable-gate)  ACTION="enable" ;;
    --disable-gate) ACTION="disable" ;;
    *)              echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

ensure_config

# Apply action
ACTIONS_TAKEN="[]"
if [ "$ACTION" = "enable" ]; then
  set_gate true
  ACTIONS_TAKEN=$(jq -n --arg dir "$PROJECT_DIR" '["Enabled the refine gate for " + $dir + "."]')
elif [ "$ACTION" = "disable" ]; then
  set_gate false
  ACTIONS_TAKEN=$(jq -n --arg dir "$PROJECT_DIR" '["Disabled the refine gate for " + $dir + "."]')
fi

GATE_ENABLED=$(read_gate)

if [ "$JSON" = "true" ]; then
  jq -n \
    --argjson gateEnabled "$GATE_ENABLED" \
    --argjson actionsTaken "$ACTIONS_TAKEN" \
    '{
      "ready": true,
      "refineGateEnabled": $gateEnabled,
      "actionsTaken": $actionsTaken
    }'
else
  echo "Refine gate: $GATE_ENABLED"
fi
